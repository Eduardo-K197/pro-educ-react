# Exemplo de configuração do front. Copie para .env.local e ajuste.

# URL da API (inclui o prefixo /v1).
NEXT_PUBLIC_SERVER_URL=http://localhost:3333/v1

# --- CRM / tempo real (opcionais) ---
# Por padrão o socket.io usa a origem de NEXT_PUBLIC_SERVER_URL e o path
# "<prefixo da API>/socket.io" (ex.: /v1/socket.io). Só defina se for diferente.
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SOCKET_PATH=
